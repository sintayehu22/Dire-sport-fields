rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(ownerUid) {
      return signedIn() && ownerUid == request.auth.uid;
    }

    // Facility presentation data.
    match /facilities/{facilityId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /bookingGroups/{bookingGroupId} {
      allow get, list: if isAdmin() || isOwner(resource.data.ownerUid);
      allow create, update, delete: if false;
    }

    // Reservation locks contain availability metadata only.
    match /fieldReservations/{reservationId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /paymentAttempts/{txRef} {
      allow get, list: if isAdmin() || isOwner(resource.data.ownerUid);
      allow create, update, delete: if false;
    }

    match /paymentReviews/{reviewId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;

      match /audit/{entryId} {
        allow get, list: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /facilityRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /reviews/{reviewId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Sanitized approved review content only.
    match /publicReviews/{reviewId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Customer and administrator notifications.
    match /adminNotifications/{notificationId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /adminActivityLog/{entryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /adminProfiles/{adminUid} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /customerAdmin/{customerUid} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /platformSettings/{settingsId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}