rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookingGroups/{bookingGroupId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'fieldId',
          'fieldName',
          'location',
          'date',
          'timeSlot',
          'durationHours',
          'hourlyPriceEtb',
          'totalPriceEtb',
          'invitedPlayers',
          'participants',
          'ownerUid',
          'status',
          'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.fieldId is string
        && request.resource.data.date is string
        && request.resource.data.timeSlot is string
        && request.resource.data.durationHours == 1
        && request.resource.data.totalPriceEtb is number
        && request.resource.data.totalPriceEtb > 0
        && request.resource.data.invitedPlayers is list
        && request.resource.data.invitedPlayers.size() <= 20
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == request.resource.data.invitedPlayers.size() + 1
        && request.resource.data.status == 'pending';

      allow get, list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /fieldReservations/{reservationId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.fieldId is string
        && request.resource.data.date is string
        && request.resource.data.timeSlot is string
        && request.resource.data.bookingGroupId is string;
      allow list, update, delete: if false;
    }
  }
}
